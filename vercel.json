{
  "version": 2,
  "builds": [
    {
      "src": "sync-awin.js",
      "use": "@vercel/node"
    },
    {
      "src": "api-test.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sync-awin",
      "dest": "/sync-awin.js"
    },
    {
      "src": "/api-test",
      "dest": "/api-test.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
