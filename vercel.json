{
  "version": 2,
  "builds": [
    {
      "src": "sync.js",
      "use": "@vercel/node"
    },
    {
      "src": "sync-promocoes.js",
      "use": "@vercel/node"
    },
    {
      "src": "programas.js",
      "use": "@vercel/node"
    },
    {
      "src": "programa.js",
      "use": "@vercel/node"
    },
    {
      "src": "transacoes.js",
      "use": "@vercel/node"
    },
    {
      "src": "awin-webhook-v2.js",
      "use": "@vercel/node"
    },
    {
      "src": "api-test.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sync",
      "dest": "/sync.js"
    },
    {
      "src": "/sync-promocoes",
      "dest": "/sync-promocoes.js"
    },
    {
      "src": "/programas",
      "dest": "/programas.js"
    },
    {
      "src": "/programa",
      "dest": "/programa.js"
    },
    {
      "src": "/transacoes",
      "dest": "/transacoes.js"
    },
    {
      "src": "/awin-webhook",
      "dest": "/awin-webhook-v2.js"
    },
    {
      "src": "/api-test",
      "dest": "/api-test.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}