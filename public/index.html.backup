
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <title>Max Promo — Alerta Inteligente de Promoções</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/favicon_io/apple-touch-icon.png">
  <link rel="manifest" href="/favicon_io/site.webmanifest">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

<div class="loading-fullscreen" id="loading-fullscreen">
  <div class="spinner-ring"></div>
  <div class="loading-text">Iniciando <span>Max Promo</span></div>
  <div class="loading-sub">Buscando as melhores ofertas...</div>
</div>

<header>
  <div class="header-left">
    <div class="app-icon">
      <img src="./imagens_app/ic_icon_app.png" alt="MAX PROMO" style="width:42px;height:42px;border-radius:10px;object-fit:contain;">
    </div>
    <h1>MAX <span>PROMO</span></h1>
  </div>
  <div class="header-right">
    <div class="savings-badge" id="savings-badge" title="Total economizado">
      <i class="fas fa-piggy-bank"></i>
      <span id="savings-total">R$ 0</span>
    </div>
    <div class="status-dot" id="status-dot" title="Conectado ao Supabase"></div>
    <button class="btn-menu-toggle" id="btn-menu-toggle" aria-label="Menu">
      <div class="menu-hamburger"><span></span><span></span><span></span></div>
      <div class="menu-label">MENU</div>
    </button>
    <div class="menu-dropdown" id="menu-dropdown">
      <div class="menu-dropdown-inner">
        <button class="menu-item" id="menu-info">
          <div class="menu-item-icon" style="background:rgba(66,165,245,0.12);color:#42A5F5;"><i class="fas fa-circle-info"></i></div>
          <div class="menu-item-text"><div class="mi-title">Informação</div><div class="mi-desc">Sobre o Max Promo</div></div>
          <i class="fas fa-chevron-right menu-item-arrow"></i>
        </button>
        <button class="menu-item" id="menu-donate">
          <div class="menu-item-icon" style="background:rgba(236,64,122,0.12);color:#EC407A;"><i class="fas fa-heart"></i></div>
          <div class="menu-item-text"><div class="mi-title">Donate</div><div class="mi-desc">Apoie o projeto</div></div>
          <i class="fas fa-chevron-right menu-item-arrow"></i>
        </button>
        <button class="menu-item" id="menu-promo-types">
          <div class="menu-item-icon" style="background:rgba(255,179,0,0.12);color:#FFB300;"><i class="fas fa-tags"></i></div>
          <div class="menu-item-text"><div class="mi-title">Tipos de Promos</div><div class="mi-desc">Todos os tipos disponíveis</div></div>
          <i class="fas fa-chevron-right menu-item-arrow"></i>
        </button>
        <div class="menu-divider"></div>
        <!-- FIX: sem onclick inline, sem !important, z-index:3 explícito via CSS -->
        <button class="menu-item-plus" id="menu-monitorar">
          <div class="plus-circle">+</div>
          <div class="menu-item-text">
            <div class="mi-title">Monitorar Produto</div>
            <div class="mi-desc">Receba alertas de preço</div>
          </div>
          <i class="fas fa-chevron-right menu-item-arrow"></i>
        </button>
        <button class="menu-item-plus" id="menu-inserir-loja">
          <div class="plus-circle">+</div>
          <div class="menu-item-text">
            <div class="mi-title">Inserir Loja</div>
            <div class="mi-desc">Adicione suas lojas favoritas</div>
          </div>
          <i class="fas fa-chevron-right menu-item-arrow"></i>
        </button>
      </div>
    </div>
  </div>
</header>

<nav class="tab-bar" id="tab-bar" role="tablist">
  <button class="tab-btn active" data-tab="feed" role="tab"><i class="fas fa-fire"></i> Em Alta</button>
  <button class="tab-btn" data-tab="monitored" role="tab"><i class="fas fa-eye"></i> Monitorados<span class="badge-count" id="monitored-count" style="display:none;">0</span></button>
  <button class="tab-btn" data-tab="history" role="tab"><i class="fas fa-chart-line"></i> Historico</button>
  <button class="tab-btn" data-tab="compare" role="tab"><i class="fas fa-balance-scale"></i> Comparar</button>
</nav>

<div class="main-content">
  <div class="search-container" id="search-bar">
    <input type="text" id="search-query" placeholder="Buscar produto, loja ou tipo de promocao..." aria-label="Buscar">
    <button class="btn-search-action" id="btn-search" title="Buscar"><i class="fas fa-search"></i></button>
  </div>
  <div class="filter-strip" id="filter-strip" role="group" aria-label="Filtros"></div>
  <div class="feed-container" id="feed-container"></div>
  <button class="fab-search" id="btn-search-toggle" title="Buscar"><i class="fas fa-search"></i></button>
  <div id="alert-container">
    <div class="alert-bar" id="alert-bar">
      <div class="alert-icon-box" id="alert-icon-box">
        <img class="alert-icon-img" id="alert-icon-img" src="" alt="" style="display:none;">
        <i class="fas fa-tags fa-fallback" id="alert-icon-fa"></i>
      </div>
      <div class="alert-info"><h3 id="alert-title">PROMOCAO!</h3><p id="alert-text">Oferta detectada</p></div>
      <button class="alert-close-btn" id="alert-close-btn"><i class="fas fa-times"></i></button>
    </div>
  </div>
  <div class="toast-notification" id="toast-msg"></div>
</div>

<!-- MODAL: Monitorar Produto -->
<div class="modal-overlay" id="modal-add-product">
  <div class="modal-box">
    <h2>Monitorar Produto</h2>
    <p>Adicione um produto para receber alertas quando o preco cair.</p>
    <label for="input-prod-name">Nome do Produto</label>
    <input type="text" id="input-prod-name" placeholder="Ex: iPhone 15 128GB">
    <label for="input-prod-target">Preco Alvo (R$)</label>
    <input type="number" id="input-prod-target" placeholder="Ex: 4999" min="0" step="0.01">
    <label for="input-prod-category">Categoria</label>
    <select id="input-prod-category">
      <option value="eletronicos">Eletronicos</option>
      <option value="moda">Moda</option>
      <option value="casa">Casa e Decoracao</option>
      <option value="beleza">Beleza e Saude</option>
      <option value="esporte">Esporte e Lazer</option>
      <option value="games">Games</option>
      <option value="livros">Livros</option>
      <option value="outro">Outro</option>
    </select>
    <div class="modal-actions">
      <button class="btn-cancel" id="btn-modal-cancel">Cancelar</button>
      <button class="btn-confirm" id="btn-modal-confirm">Monitorar</button>
    </div>
  </div>
</div>

<!-- MODAL: Inserir Loja (3 steps) — store-error DENTRO do modal-box, não fora -->
<div class="modal-overlay" id="modal-add-store">
  <div class="modal-box">

    <!-- STEP 1 -->
    <div id="store-step-1">
      <h2><i class="fas fa-store" style="color:var(--accent-color);margin-right:8px;"></i>Inserir Loja</h2>
      <p>Preencha os dados e escolha o plano. O pagamento é via PIX, único e sem renovação automática.</p>

      <div class="section-label"><i class="fas fa-layer-group"></i> Escolha o plano</div>
      <!-- FIX: onclick chama selecionarPlano(this) — função global definida no JS -->
      <div class="planos-grid">
        <div class="plano-card" data-dias="30" data-valor="9.90" onclick="selecionarPlano(this)">
          <div class="plano-dias">30 dias</div>
          <div class="plano-valor">R$ 9,90</div>
          <div class="plano-desc">Teste o serviço</div>
        </div>
        <div class="plano-card" data-dias="60" data-valor="19.90" onclick="selecionarPlano(this)">
          <div class="plano-popular">Popular</div>
          <div class="plano-dias">60 dias</div>
          <div class="plano-valor">R$ 19,90</div>
          <div class="plano-desc">R$ 0,33/dia</div>
        </div>
        <div class="plano-card" data-dias="90" data-valor="39.90" onclick="selecionarPlano(this)">
          <div class="plano-dias">90 dias</div>
          <div class="plano-valor">R$ 39,90</div>
          <div class="plano-desc">R$ 0,44/dia</div>
        </div>
        <div class="plano-card" data-dias="365" data-valor="99.90" onclick="selecionarPlano(this)">
          <div class="plano-dias">365 dias</div>
          <div class="plano-valor">R$ 99,90</div>
          <div class="plano-desc">Melhor custo</div>
        </div>
      </div>
      <!-- aviso inline quando tenta continuar sem plano -->
      <div class="plano-aviso" id="plano-aviso">
        <i class="fas fa-triangle-exclamation"></i> Selecione um plano para continuar
      </div>

      <div class="section-label"><i class="fas fa-pencil"></i> Dados da loja</div>
      <label for="input-store-name">Nome da Loja</label>
      <input type="text" id="input-store-name" placeholder="Ex: Minha Loja"
             oninput="limparErro(this)">
      <label for="input-store-url">Site / URL</label>
      <input type="url" id="input-store-url" placeholder="https://minhaloja.com.br"
             oninput="limparErro(this)">
      <label for="input-store-cat">Tipo de Promoção Principal</label>
      <select id="input-store-cat">
        <option value="desconto">Desconto</option>
        <option value="flash">Flash Sale</option>
        <option value="cupom">Cupom</option>
        <option value="cashback">Cashback</option>
        <option value="frete_gratis">Frete Grátis</option>
        <option value="saldao">Saldão</option>
        <option value="outlet">Outlet</option>
        <option value="live">Live Sale</option>
        <option value="sorteio">Sorteio</option>
  <div class="loading-fullscreen" id="loading-fullscreen">
    <div class="spinner-ring"></div>
    <div class="loading-text">Iniciando <span>Max Promo</span></div>
    <div class="loading-sub">Buscando as melhores ofertas...</div>
  </div>

  <header>
    <div class="header-left">
      <div class="app-icon">
        <img src="./imagens_app/ic_icon_app.png" alt="MAX PROMO" style="width:42px;height:42px;border-radius:10px;object-fit:contain;">
      </div>
      <h1>MAX <span>PROMO</span></h1>
    </div>
    <div class="header-right">
      <div class="savings-badge" id="savings-badge" title="Total economizado">
        <i class="fas fa-piggy-bank"></i>
        <span id="savings-total">R$ 0</span>
      </div>
      <div class="status-dot" id="status-dot" title="Conectado ao Supabase"></div>
      <button class="btn-menu-toggle" id="btn-menu-toggle" aria-label="Menu">
        <div class="menu-hamburger"><span></span><span></span><span></span></div>
        <div class="menu-label">MENU</div>
      </button>
      <div class="menu-dropdown" id="menu-dropdown">
        <div class="menu-dropdown-inner">
          <button class="menu-item" id="menu-info">
            <div class="menu-item-icon" style="background:rgba(66,165,245,0.12);color:#42A5F5;"><i class="fas fa-circle-info"></i></div>
            <div class="menu-item-text"><div class="mi-title">Informação</div><div class="mi-desc">Sobre o Max Promo</div></div>
            <i class="fas fa-chevron-right menu-item-arrow"></i>
          </button>
          <button class="menu-item" id="menu-donate">
            <div class="menu-item-icon" style="background:rgba(236,64,122,0.12);color:#EC407A;"><i class="fas fa-heart"></i></div>
            <div class="menu-item-text"><div class="mi-title">Donate</div><div class="mi-desc">Apoie o projeto</div></div>
            <i class="fas fa-chevron-right menu-item-arrow"></i>
          </button>
          <button class="menu-item" id="menu-promo-types">
            <div class="menu-item-icon" style="background:rgba(255,179,0,0.12);color:#FFB300;"><i class="fas fa-tags"></i></div>
            <div class="menu-item-text"><div class="mi-title">Tipos de Promos</div><div class="mi-desc">Todos os tipos disponíveis</div></div>
            <i class="fas fa-chevron-right menu-item-arrow"></i>
          </button>
          <div class="menu-divider"></div>
          <button class="menu-item-plus" id="menu-monitorar">
            <div class="plus-circle">+</div>
            <div class="menu-item-text"><div class="mi-title">Monitorar Produto</div><div class="mi-desc">Receba alertas de preço</div></div>
            <i class="fas fa-chevron-right menu-item-arrow"></i>
          </button>
          <button class="menu-item-plus" id="menu-inserir-loja">
            <div class="plus-circle">+</div>
            <div class="menu-item-text"><div class="mi-title">Inserir Loja</div><div class="mi-desc">Adicione suas lojas favoritas</div></div>
            <i class="fas fa-chevron-right menu-item-arrow"></i>
          </button>
        </div>
      </div>
    </div>
  </header>

  <nav class="tab-bar" id="tab-bar" role="tablist">
    <button class="tab-btn active" data-tab="feed" role="tab"><i class="fas fa-fire"></i> Em Alta</button>
    <button class="tab-btn" data-tab="monitored" role="tab"><i class="fas fa-eye"></i> Monitorados<span class="badge-count" id="monitored-count" style="display:none;">0</span></button>
    <button class="tab-btn" data-tab="history" role="tab"><i class="fas fa-chart-line"></i> Historico</button>
    <button class="tab-btn" data-tab="compare" role="tab"><i class="fas fa-balance-scale"></i> Comparar</button>
  </nav>

  <div class="main-content">
    <div class="search-container" id="search-bar">
      <input type="text" id="search-query" placeholder="Buscar produto, loja ou tipo de promocao..." aria-label="Buscar">
      <button class="btn-search-action" id="btn-search" title="Buscar"><i class="fas fa-search"></i></button>
    </div>
    <div class="filter-strip" id="filter-strip" role="group" aria-label="Filtros"></div>
    <div class="feed-container" id="feed-container"></div>
    <button class="fab-search" id="btn-search-toggle" title="Buscar"><i class="fas fa-search"></i></button>
    <div id="alert-container">
      <div class="alert-bar" id="alert-bar">
        <div class="alert-icon-box" id="alert-icon-box">
          <img class="alert-icon-img" id="alert-icon-img" src="" alt="" style="display:none;">
          <i class="fas fa-tags fa-fallback" id="alert-icon-fa"></i>
        </div>
        <div class="alert-info"><h3 id="alert-title">PROMOCAO!</h3><p id="alert-text">Oferta detectada</p></div>
        <button class="alert-close-btn" id="alert-close-btn"><i class="fas fa-times"></i></button>
      </div>
    </div>
    <div class="toast-notification" id="toast-msg"></div>
  </div>

  <!-- MODAL: Monitorar Produto -->
  <div class="modal-overlay" id="modal-add-product">
    <div class="modal-box">
      <h2>Monitorar Produto</h2>
      <p>Adicione um produto para receber alertas quando o preco cair.</p>
      <label for="input-prod-name">Nome do Produto</label>
      <input type="text" id="input-prod-name" placeholder="Ex: iPhone 15 128GB">
      <label for="input-prod-target">Preco Alvo (R$)</label>
      <input type="number" id="input-prod-target" placeholder="Ex: 4999" min="0" step="0.01">
      <label for="input-prod-category">Categoria</label>
      <select id="input-prod-category">
        <option value="eletronicos">Eletronicos</option>
        <option value="moda">Moda</option>
        <option value="casa">Casa e Decoracao</option>
        <option value="beleza">Beleza e Saude</option>
        <option value="esporte">Esporte e Lazer</option>
        <option value="games">Games</option>
        <option value="livros">Livros</option>
        <option value="outro">Outro</option>
      </select>
      <label for="input-store-email">Seu E-mail (para recibo)</label>
      <input type="email" id="input-store-email" placeholder="seuemail@exemplo.com"
             oninput="limparErro(this)">

      <div class="modal-actions">
        <button class="btn-cancel" id="btn-store-cancel">Cancelar</button>
        <button class="btn-confirm" id="btn-store-step1-next" disabled>
          <i class="fas fa-lock" style="font-size:.75rem;margin-right:6px;"></i>Continuar → Pagar PIX
        </button>
      </div>
    </div>

    <!-- STEP 2 -->
    <div id="store-step-2" style="display:none;">
      <div class="step-pix-header">
        <h2><i class="fas fa-qrcode" style="color:#4CAF50;margin-right:8px;"></i>Pague via PIX</h2>
        <p>Escaneie o QR Code ou copie a chave.<br>Após o pagamento, clique em <strong>"Já Paguei"</strong>.</p>
      </div>
      <div class="pix-valor-destaque">
        <i class="fas fa-receipt" style="color:#4CAF50;"></i>
        <span id="pix-valor-label">R$ 9,90</span>
        <span style="font-size:.75rem;color:var(--text-muted);">•</span>
        <span id="pix-dias-label" style="font-size:.75rem;color:var(--text-muted);"></span>
      </div>
      <div style="text-align:center;">
        <div class="qr-wrapper" id="pix-qr-wrapper">
          <canvas id="pix-qr-canvas" width="180" height="180"></canvas>
        </div>
      </div>
      <div class="pix-copiacola-row">
        <input id="pix-key-display" readonly placeholder="Gerando código PIX...">
        <button class="btn-copy-pix" id="btn-copy-pix" title="Copiar"><i class="fas fa-copy"></i></button>
      </div>
      <div class="manual-instrucoes">
        <strong><i class="fas fa-circle-info" style="color:var(--accent-color);margin-right:4px;"></i>Como pagar:</strong>
        <ol>
          <li>Abra o app do seu banco</li>
          <li>Escolha <strong>PIX → Copia e Cola</strong> ou escaneie o QR</li>
          <li>Confirme o valor: <strong id="instrucao-valor">R$ 9,90</strong></li>
          <li>Pague e clique em <strong>"Já Paguei"</strong> abaixo</li>
        </ol>
      </div>
      <div class="pix-timer-box" id="pix-timer-box">
        <i class="fas fa-clock"></i>
        <span>QR válido por: </span>
        <span id="pix-countdown">10:00</span>
      </div>
      <div class="pix-status-msg aguardando" id="pix-status-msg">
        <i class="fas fa-hourglass-half" style="color:var(--accent-color);"></i>
        Aguardando confirmação do pagamento...
      </div>
      <div class="dev-bar" id="dev-bar-teste" style="display:none;">
        <i class="fas fa-flask"></i>
        <span><strong>Modo teste</strong> — simula pagamento confirmado</span>
        <button class="btn-dev-confirm" id="btn-dev-simular">✔ Simular Pago</button>
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" id="btn-store-step2-back">← Voltar</button>
        <button class="btn-confirm" id="btn-store-step2-paguei">
          <i class="fas fa-check-circle" style="font-size:.8rem;margin-right:5px;"></i>Já Paguei
        </button>
      </div>
  </div>

  <!-- MODAL: Inserir Loja (3 steps) -->
  <div class="modal-overlay" id="modal-add-store">
    <div class="modal-box">

      <!-- STEP 1 -->
      <div id="store-step-1">
        <h2><i class="fas fa-store" style="color:var(--accent-color);margin-right:8px;"></i>Inserir Loja</h2>
        <p>Preencha os dados e escolha o plano. O pagamento é via PIX, único e sem renovação automática.</p>
        <div class="section-label"><i class="fas fa-layer-group"></i> Escolha o plano</div>
        <div class="planos-grid">
          <div class="plano-card" data-dias="30" data-valor="9.90" onclick="selecionarPlano(this)">
            <div class="plano-dias">30 dias</div>
            <div class="plano-valor">R$ 9,90</div>
            <div class="plano-desc">Teste o serviço</div>
          </div>
          <div class="plano-card" data-dias="60" data-valor="19.90" onclick="selecionarPlano(this)">
            <div class="plano-popular">Popular</div>
            <div class="plano-dias">60 dias</div>
            <div class="plano-valor">R$ 19,90</div>
            <div class="plano-desc">R$ 0,33/dia</div>
          </div>
          <div class="plano-card" data-dias="90" data-valor="39.90" onclick="selecionarPlano(this)">
            <div class="plano-dias">90 dias</div>
            <div class="plano-valor">R$ 39,90</div>
            <div class="plano-desc">R$ 0,44/dia</div>
          </div>
          <div class="plano-card" data-dias="365" data-valor="99.90" onclick="selecionarPlano(this)">
            <div class="plano-dias">365 dias</div>
            <div class="plano-valor">R$ 99,90</div>
            <div class="plano-desc">Melhor custo</div>
          </div>
        </div>
        <div class="section-label"><i class="fas fa-pencil"></i> Dados da loja</div>
        <label for="input-store-name">Nome da Loja</label>
        <input type="text" id="input-store-name" placeholder="Ex: Minha Loja">
        <label for="input-store-url">Site / URL</label>
        <input type="url" id="input-store-url" placeholder="https://minhaloja.com.br">
        <label for="input-store-cat">Tipo de Promoção Principal</label>
        <select id="input-store-cat">
          <option value="desconto">Desconto</option>
          <option value="flash">Flash Sale</option>
          <option value="cupom">Cupom</option>
          <option value="cashback">Cashback</option>
          <option value="frete_gratis">Frete Grátis</option>
          <option value="saldao">Saldão</option>
          <option value="outlet">Outlet</option>
          <option value="live">Live Sale</option>
          <option value="sorteio">Sorteio</option>
        </select>
        <label for="input-store-email">Seu E-mail (para recibo)</label>
        <input type="email" id="input-store-email" placeholder="seuemail@exemplo.com">
        <div class="modal-actions">
          <button class="btn-cancel" id="btn-store-cancel">Cancelar</button>
          <button class="btn-confirm" id="btn-store-step1-next" disabled>
