var iconCache = {};
function testarIconeDisponivel(src,cb){if(iconCache.hasOwnProperty(src)){cb(iconCache[src]);return}var img=new Image();img.onload=function(){iconCache[src]=true;cb(true)};img.onerror=function(){iconCache[src]=false;cb(false)};img.src=src}
function preTestarTodosIcones(){Object.keys(PROMO_CONFIG).forEach(function(t){testarIconeDisponivel(PROMO_CONFIG[t].icon,function(){})})}
function gerarHTMLIcone(tipo,tamanho){var c=PROMO_CONFIG[tipo]||PROMO_CONFIG['desconto'];var sc=tamanho==='grande'?'alert-icon-img':'promo-icon-img';if(iconCache[c.icon]===true)return'<img class="'+sc+'" src="'+c.icon+'" alt="'+c.label+'"><i class="'+c.faIcon+' fa-fallback" style="display:none;"></i>';if(iconCache[c.icon]===false)return'<i class="'+c.faIcon+' fa-fallback"></i>';return'<img class="'+sc+'" src="'+c.icon+'" alt="'+c.label+'" onerror="this.classList.add(\'img-failed\');this.style.display=\'none\';var f=this.nextElementSibling;if(f)f.style.display=\'\';" onload="var f=this.nextElementSibling;if(f)f.style.display=\'none\';"><i class="'+c.faIcon+' fa-fallback"></i>'}

