/* ── ALERTAS ROTATIVOS ── */
var _alertaFila=[],_alertaTipoUltimo=null,_alertaIntervalId=null;
function _embaralhar(arr){for(var i=arr.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=arr[i];arr[i]=arr[j];arr[j]=t}return arr}
function _montarFilaAlertas(promos){
  var lista=(promos||MOCK_PROMOS).filter(function(p){return p.precoNew>0||p.tipo==='sorteio'});
  var urgentes=_embaralhar(lista.filter(function(p){var c=PROMO_CONFIG[p.tipo];return c&&(c.urgent||c.isLive)}));
  var normais=_embaralhar(lista.filter(function(p){var c=PROMO_CONFIG[p.tipo];return!(c&&(c.urgent||c.isLive))}));
  var result=[],ni=0,ui=0;
  while(ui<urgentes.length||ni<normais.length){
    if(ui<urgentes.length)result.push(urgentes[ui++]);
    if(ni<normais.length)result.push(normais[ni++]);
    if(ni<normais.length)result.push(normais[ni++]);
  }
  return result;
}
function _proximoAlerta(promos){
  if(!_alertaFila.length)_alertaFila=_montarFilaAlertas(promos);
  var tentativas=0,item=null;
  while(_alertaFila.length&&tentativas<_alertaFila.length){
    var c=_alertaFila.shift();
    if(c.tipo!==_alertaTipoUltimo){item=c;break}
    _alertaFila.push(c);tentativas++;
  }
  if(!item&&_alertaFila.length)item=_alertaFila.shift();
  if(_alertaFila.length<3)_alertaFila=_alertaFila.concat(_montarFilaAlertas(promos));
  return item;
}
function iniciarRotacaoAlertas(promos){
  clearInterval(_alertaIntervalId);
  _alertaFila=_montarFilaAlertas(promos);
  setTimeout(function(){_dispararProximoAlerta(promos)},3000);
  _alertaIntervalId=setInterval(function(){_dispararProximoAlerta(promos)},9000);
}
function _dispararProximoAlerta(promos){
  if(!alertasAtivados)return;
  var item=_proximoAlerta(promos);if(!item)return;
  _alertaTipoUltimo=item.tipo;
  var c=PROMO_CONFIG[item.tipo]||PROMO_CONFIG['desconto'];
  var msg=item.titulo+' em '+item.loja;
  if(item.precoNew>0&&item.precoOld>0&&item.precoNew<item.precoOld){
    var pct=Math.round((1-item.precoNew/item.precoOld)*100);
    msg=item.titulo+' — de R$'+item.precoOld.toLocaleString('pt-BR')+' por R$'+item.precoNew.toLocaleString('pt-BR')+' (−'+pct+'%) em '+item.loja;
  }
  dispararAlertaPromocaoIA(msg,item.tipo);
}

