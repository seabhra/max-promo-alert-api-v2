var MOCK_PROMOS=[{id:1,tipo:'flash',titulo:'Bolsa Hobo – edição limitada',desc:'Flash Sale: 10% OFF por 2 horas apenas!',loja:'Atelier Sorelle Santos',precoOld:3499,precoNew:126.00,tempoRestante:7200,link:'https://ateliersorellesantos.vercel.app/'},{id:2,tipo:'cupom',titulo:'Fone Bluetooth Sony WH-1000XM5',desc:'Use o cupom RADAR10 e ganhe 10% OFF',loja:'SomMax',precoOld:2299,precoNew:2069,cupom:'RADAR10'},{id:3,tipo:'frete_gratis',titulo:'Kit Organizacao Closet 5 pecas',desc:'Frete Grátis em compras acima de R$ 99',loja:'Casa&Estrutura',precoOld:189,precoNew:149},{id:4,tipo:'cashback',titulo:'Perfume Tom Ford Tobacco Vanille 50ml',desc:'10% de Cashback na sua carteira digital',loja:'BelezaVIP',precoOld:1450,precoNew:1299},{id:5,tipo:'leve_pague',titulo:'Camiseta Polo Classic',desc:'Compre 2, Leve 3 — Pague 2!',loja:'ModaFit',precoOld:89,precoNew:59},{id:6,tipo:'blackfriday',titulo:'MacBook Air M3 256GB',desc:'Black Friday: Maiores descontos do ano!',loja:'AppleZone',precoOld:12499,precoNew:9999},{id:7,tipo:'saldao',titulo:'Jaqueta de Couro Legítimo',desc:'Saldão de Inverno — ate 70% OFF',loja:'Couro&Style',precoOld:899,precoNew:269},{id:8,tipo:'outlet',titulo:'Tenis Nike Air Max 90',desc:'Outlet de Fabrica — pecas de colecao passada',loja:'SneakerOutlet',precoOld:749,precoNew:349},{id:9,tipo:'brinde',titulo:'Skincare Coreano Set 7 Steps',desc:'Ganhe um brinde exclusivo na compra acima de R$ 150',loja:'KBeauty',precoOld:280,precoNew:199},{id:10,tipo:'progressivo',titulo:'Vinho Malbec Argentino',desc:'Compre 2 = 10% | 3 = 20% | 4 = 30% OFF',loja:'VinhoPremium',precoOld:89,precoNew:62},{id:11,tipo:'primeira',titulo:'Kindle Paperwhite 11a Geracao',desc:'20% OFF na sua primeira compra!',loja:'LivrariaDigital',precoOld:649,precoNew:519},{id:12,tipo:'live',titulo:'Make Set Profissional 24 pecas',desc:'AO VIVO agora: Ofertas exclusivas na live!',loja:'GlamLive',precoOld:450,precoNew:189},{id:13,tipo:'combo',titulo:'Kit Gamer: Mouse + Teclado + Mousepad',desc:'Kit Completo: