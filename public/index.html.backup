/* ── UTILITÁRIOS GERAIS ─────────────────────────── */
function ajustarBrilho(hex,p){var n=parseInt(hex.replace('#',''),16);var a=Math.round(2.55*p);var R=(n>>16)+a;var G=(n>>8&0xFF)+a;var B=(n&0xFF)+a;return'#'+(0x1000000+(R<255?R<1?0:R:255)*0x10000+(G<255?G<1?0:G:255)*0x100+(B<255?B<1?0:B:255)).toString(16).slice(1)}
function showNotification(m){var t=document.getElementById('toast-msg');t.textContent=m;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(function(){t.classList.remove('show')},2800)}
function fallbackCopy(text){var ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.left='-9999px';document.body.appendChild(ta);ta.select();try{document.execCommand('copy')}catch(e){}document.body.removeChild(ta)}
function formatarTempo(s){var h=Math.floor(s/3600);var m=Math.floor((s%3600)/60);var sec=s%60;if(h>0)return h+'h '+String(m).padStart(2,'0')+'m';if(m>0)return m+'m '+String(sec).padStart(2,'0')+'s';return sec+'s'}
function formatarDinheiro(v){return'R$ '+Number(v).toFixed(2).replace('.',',')}
function calcularExpiracao(dias){var d=new Date();d.setDate(d.getDate()+parseInt(dias));return d.toLocaleDateString('pt-BR')}
function openModal(id){document.getElementById(id).classList.add('active');fecharMenu()}
function closeModal(id){document.getElementById(id).classList.remove('active')}

/* FIX: validação com highlight de campo E toast */
function marcarErro(elId,msg){
  var el=document.getElementById(elId);
  if(el){el.classList.add('input-error');el.focus()}
  showNotification('⚠ '+msg);
}
function limparErro(el){if(el)el.classList.remove('input-error')}

/* ── SUPABASE ── */
async function buscarPromocoesSupabase(){try{var u='/api/promos?limite=50';if(filtroAtivo)u+='&tipo='+filtroAtivo;var r=await fetch(u);if(!r.ok)throw 0;var d=await r.json();if(d.promocoes&&d.promocoes.length>0){supabaseOnline=true;document.getElementById('status-dot').classList.remove('offline');return d.promocoes.map(function(p){return{id:p.id,tipo:p.tipo,titulo:p.titulo,desc:p.descricao||'',loja:p.loja||'?',precoOld:p.preco_antigo||0,precoNew:p.preco_novo||0,cupom:p.cupom||null,tempoRestante:p.tempo_restante||0,fonte:p.fonte||'',urlAfiliado:p.url_afiliado||null}})}return null}catch(e){supabaseOnline=false;document.getElementById('status-dot').classList.add('offline');return null}}

/* ── ALERTA VISUAL ── */
function dispararAlertaPromocaoIA(msg,tipo){if(!alertasAtivados)return;var bar=document.getElementById('alert-bar');bar.classList.remove('alert-bar-critico');bar.style.background='';bar.style.color='';bar.style.borderTopColor='';var c=PROMO_CONFIG[tipo]||PROMO_CONFIG['desconto'];document.getElementById('alert-title').textContent=c.emoji+' '+c.label+'!';document.getElementById('alert-text').textContent=msg;var ib=document.getElementById('alert-icon-box');ib.style.background='linear-gradient(135deg,'+c.color+','+ajustarBrilho(c.color,-25)+')';ib.innerHTML=gerarHTMLIcone(tipo,'grande');if(c.urgent||tipo==='blackfriday')bar.classList.add('alert-bar-critico');if(tipo==='flash'){bar.style.background='linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+')';bar.style.color='#000'}else if(tipo==='blackfriday'){bar.style.background='linear-gradient(90deg,#212121,#111)';bar.style.borderTopColor='#FFD700';bar.style.color='#FFD700'}else if(tipo==='bilhete'){bar.style.background='linear-gradient(90deg,#1a1a2e,#16213e)';bar.style.borderTopColor='#FFD700';bar.style.color='#FFD700'}else{bar.style.background='linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+')';bar.style.color='#fff'}var ct=document.getElementById('alert-container');if(ct.style.display!=='block'){ct.style.display='block';ct.style.animation='none';ct.offsetHeight;ct.style.animation='slideUp 0.35s ease-out'}try{var snd=document.getElementById('alert-sound');if(snd&&snd.src){snd.currentTime=0;snd.play().catch(function(){})}}catch(e){}clearTimeout(alertTimeout);alertTimeout=setTimeout(function(){esconderAlertaVisual()},7000);savingsTotal+=Math.floor(Math.random()*80)+20;document.getElementById('savings-total').textContent='R$ '+savingsTotal.toLocaleString('pt-BR')}
function esconderAlertaVisual(){document.getElementById('alert-container').style.display='none';var b=document.getElementById('alert-bar');b.classList.remove('alert-bar-critico');b.style.color='';b.style.borderTopColor=''}

/* ── TIMERS FLASH ── */
function iniciarTimer(id,seg){var rem=seg;clearInterval(flashTimers[id]);flashTimers[id]=setInterval(function(){rem--;var el=document.getElementById('timer-'+id);if(!el){clearInterval(flashTimers[id]);return}if(rem<=0){el.querySelector('.timer-value').textContent='Encerrado';el.classList.add('urgent');clearInterval(flashTimers[id]);return}el.querySelector('.timer-value').textContent=formatarTempo(rem);if(rem<600)el.classList.add('urgent')},1000)}

/* ── RENDER FEED ── */
async function renderFeed(promos){var ct=document.getElementById('feed-container');ct.innerHTML='';var lista=promos;if(!lista){var sd=await buscarPromocoesSupabase();lista=sd||MOCK_PROMOS}if(filtroAtivo)lista=lista.filter(function(p){return p.tipo===filtroAtivo});var q=document.getElementById('search-query').value.trim().toLowerCase();if(q.length>=2)lista=lista.filter(function(p){return p.titulo.toLowerCase().indexOf(q)!==-1||p.desc.toLowerCase().indexOf(q)!==-1||p.loja.toLowerCase().indexOf(q)!==-1||(PROMO_CONFIG[p.tipo]&&PROMO_CONFIG[p.tipo].label.toLowerCase().indexOf(q)!==-1)});if(!lista.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-search"></i><p>Nenhuma oferta encontrada.</p></div>';return}lista.forEach(function(p,i){var c=PROMO_CONFIG[p.tipo]||PROMO_CONFIG['desconto'];var card=document.createElement('div');card.className='promo-card';card.style.animationDelay=(i*0.06)+'s';var u=c.urgent,l=c.isLive,ht=p.tempoRestante>0;var po=p.precoOld>0?'R$ '+p.precoOld.toLocaleString('pt-BR'):'';var pn=p.precoNew>0?'R$ '+p.precoNew.toLocaleString('pt-BR'):'Gratuito';var pd='';if(p.precoOld>0&&p.precoNew>0){var pc=Math.round((1-p.precoNew/p.precoOld)*100);if(pc>0)pd='-'+pc+'%'}var hh='';var hi=MOCK_PRICE_HISTORY[p.id];if(hi&&hi.length){var mx=Math.max.apply(null,hi),mn=Math.min.apply(null,hi);hh='<div class="price-history-mini">';hi.forEach(function(v){var h=3+((v-mn)/(mx-mn+1))*27;var cl=v===hi[hi.length-1]?'#4CAF50':'rgba(255,255,255,0.15)';hh+='<div class="price-bar" style="height:'+h+'px;background:'+cl+';"></div>'});hh+='</div>'}var th='';if(ht)th='<div class="promo-timer urgent" id="timer-'+p.id+'"><i class="fas fa-clock"></i> <span class="timer-value">'+formatarTempo(p.tempoRestante)+'</span></div>';var bc=c.goldAccent||c.color;var bt='Aproveitar';if(p.cupom)bt='Cupom: '+p.cupom;if(l)bt='Assistir Live';var lh=l?'<div class="live-indicator"><div class="live-dot"></div> AO VIVO</div>':'';var sh=p.fonte?'<span class="source-badge" style="background:rgba(255,255,255,0.05);color:var(--text-muted);"><i class="fas fa-rss" style="font-size:0.5rem;"></i> '+p.fonte+'</span>':'';var ih=gerarHTMLIcone(p.tipo,'pequeno');card.innerHTML='<div class="promo-card-accent" style="background:linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+');"></div><div class="promo-card-body"><div class="promo-card-icon" style="background:linear-gradient(135deg,'+c.color+','+ajustarBrilho(c.color,-30)+');">'+ih+(u?'<div class="pulse-ring"></div>':'')+'</div><div class="promo-card-content"><div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;"><span class="promo-card-type" style="background:'+ajustarBrilho(c.color,-60)+';color:'+c.color+';">'+c.label+'</span>'+(pd?'<span style="font-size:0.72rem;font-weight:800;color:#4CAF50;">'+pd+'</span>':'')+lh+sh+'</div><div class="promo-card-title">'+p.titulo+'</div><div class="promo-card-desc">'+p.desc+'</div><div class="promo-card-meta">'+(po?'<span class="promo-price-old">'+po+'</span>':'')+'<span class="promo-price-new" style="color:'+(p.precoNew<p.precoOld?'#4CAF50':'var(--text-main)')+';">'+pn+'</span><span class="promo-store"><i class="fas fa-store"></i> '+p.loja+'</span></div>'+hh+'</div></div><div class="promo-card-footer">'+th+'<button class="promo-btn-grab" style="background:linear-gradient(135deg,'+bc+','+ajustarBrilho(bc,-15)+');">'+bt+'</button></div>';ct.appendChild(card);if(p.urlAfiliado)card.addEventListener('click',function(){window.open(p.urlAfiliado,'_blank','noopener')});if(ht)iniciarTimer(p.id,p.tempoRestante)});
  iniciarRotacaoAlertas(lista);
}

function renderMonitored(){var ct=document.getElementById('feed-container');ct.innerHTML='';if(!monitoredProducts.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-eye-slash"></i><p>Nenhum produto monitorado.<br>Use o menu para adicionar.</p></div>';return}monitoredProducts.forEach(function(p,i){var card=document.createElement('div');card.className='monitored-card';card.style.animationDelay=(i*0.06)+'s';var sc='#4CAF50';if(p.currentPrice>p.targetPrice*1.1)sc='#ff4444';else if(p.currentPrice>p.targetPrice)sc='#FFB300';card.innerHTML='<div class="prod-img" style="color:'+sc+';"><i class="fas fa-box"></i></div><div class="prod-info"><div class="prod-name">'+p.name+'</div><div class="prod-target">Alvo: R$ '+p.targetPrice.toLocaleString('pt-BR')+'</div></div><div class="prod-current" style="color:'+sc+';">R$ '+p.currentPrice.toLocaleString('pt-BR')+'</div><button class="remove-btn" data-idx="'+i+'" title="Remover"><i class="fas fa-trash"></i></button>';ct.appendChild(card);card.querySelector('.remove-btn').addEventListener('click',function(){monitoredProducts.splice(parseInt(this.getAttribute('data-idx')),1);renderMonitored();atualizarBadgeMonitorados();showNotification('Produto removido')})})}
function renderHistory(){var ct=document.getElementById('feed-container');ct.innerHTML='';var pp=MOCK_PROMOS.filter(function(p){return MOCK_PRICE_HISTORY[p.id]});if(!pp.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-chart-line"></i><p>Nenhum historico.</p></div>';return}var ms=['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];pp.forEach(function(p,i){var c=PROMO_CONFIG[p.tipo]||PROMO_CONFIG['desconto'];var h=MOCK_PRICE_HISTORY[p.id];var mx=Math.max.apply(null,h),mn=Math.min.apply(null,h);var card=document.createElement('div');card.className='promo-card';card.style.animationDelay=(i*0.06)+'s';var bh='<div style="display:flex;align-items:flex-end;gap:4px;height:80px;padding:10px 0;">';h.forEach(function(v,j){var hi=8+((v-mn)/(mx-mn+1))*65;var cl=j===h.length-1?'#4CAF50':'rgba(255,179,0,0.3)';bh+='<div style="display:flex;flex-direction:column;align-items:center;flex:1;gap:2px;"><div style="width:100%;height:'+hi+'px;background:'+cl+';border-radius:3px 3px 0 0;min-height:4px;"></div><span style="font-size:0.5rem;color:var(--text-muted);">'+ms[j]+'</span></div>'});bh+='</div>';card.innerHTML='<div class="promo-card-accent" style="background:linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+');"></div><div style="padding:14px 16px;"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;"><span class="promo-card-type" style="background:'+ajustarBrilho(c.color,-60)+';color:'+c.color+';">'+c.label+'</span><span style="font-weight:700;font-size:0.9rem;">'+p.titulo+'</span></div><div style="display:flex;gap:16px;font-size:0.8rem;margin-bottom:4px;"><span style="color:var(--text-muted);">Maior: R$ '+mx.toLocaleString('pt-BR')+'</span><span style="color:#4CAF50;">Menor: R$ '+mn.toLocaleString('pt-BR')+'</span></div>'+bh+'</div>';ct.appendChild(card)})}
function renderCompare(){var ct=document.getElementById('feed-container');ct.innerHTML='';var pk=Object.keys(MOCK_COMPARE);if(!pk.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-balance-scale"></i><p>Nenhum produto para comparar.</p></div>';return}pk.forEach(function(nm,i){var ls=MOCK_COMPARE[nm].slice().sort(function(a,b){return a.preco-b.preco});var ml=ls[0].preco;var card=document.createElement('div');card.className='promo-card';card.style.animationDelay=(i*0.06)+'s';var rh='';ls.forEach(function(l){var ib=l.preco===ml;rh+='<div class="compare-row"><span class="compare-store"><i class="fas fa-store" style="margin-right:6px;color:'+(ib?'#4CAF50':'var(--text-muted)')+';"></i>'+l.loja+(ib?' <span style="font-size:0.65rem;font-weight:800;color:#4CAF50;">MELHOR PRECO</span>':'')+'</span><span class="compare-price '+(ib?'compare-best':'')+'">R$ '+l.preco.toLocaleString('pt-BR')+'</span></div>'});card.innerHTML='<div class="promo-card-accent" style="background:linear-gradient(90deg,#4CAF50,#2E7D32);"></div><div style="padding:14px 16px;"><div style="font-weight:700;font-size:0.95rem;margin-bottom:12px;"><i class="fas fa-balance-scale" style="margin-right:8px;color:#4CAF50;"></i>'+nm+'</div>'+rh+'</div>';ct.appendChild(card)})}
function renderFilters(){var st=document.getElementById('filter-strip');st.innerHTML='';var ca=document.createElement('button');ca.className='filter-chip'+(!filtroAtivo?' active':'');ca.innerHTML='<i class="fas fa-th"></i> Todos';ca.addEventListener('click',function(){filtroAtivo=null;renderFilters();renderCurrentTab()});st.appendChild(ca);['flash','cupom','frete_gratis','cashback','leve_pague','blackfriday','saldao','outlet','desconto','brinde','progressivo','combo','parcela','live','misterio','sorteio'].forEach(function(t){var c=PROMO_CONFIG[t];if(!c)return;var ch=document.createElement('button');ch.className='filter-chip'+(filtroAtivo===t?' active':'');ch.innerHTML='<span class="chip-dot" style="background:'+c.color+';"></span> '+c.label;ch.addEventListener('click',function(){filtroAtivo=filtroAtivo===t?null:t;renderFilters();renderCurrentTab()});st.appendChild(ch)})}
function renderPromoTypesGrid(){var g=document.getElementById('promo-types-grid');g.innerHTML='';Object.keys(PROMO_CONFIG).forEach(function(t){var c=PROMO_CONFIG[t];var it=document.createElement('div');it.className='promo-type-item';it.innerHTML='<div class="promo-type-dot" style="background:'+c.color+';"></div><div class="promo-type-label">'+c.emoji+' '+c.label+'</div>';g.appendChild(it)})}
function renderCurrentTab(){if(tabAtiva==='feed')renderFeed();else if(tabAtiva==='monitored')renderMonitored();else if(tabAtiva==='history')renderHistory();else if(tabAtiva==='compare')renderCompare()}
function atualizarBadgeMonitorados(){var b=document.getElementById('monitored-count');if(monitoredProducts.length>0){b.style.display='flex';b.textContent=monitoredProducts.length}else{b.style.display='none'}}

/* ── MENU ── */
function toggleMenu(){menuAberto=!menuAberto;var d=document.getElementById('menu-dropdown');var t=document.getElementById('btn-menu-toggle');if(menuAberto){d.classList.add('open');t.classList.add('active')}else{d.classList.remove('open');t.classList.remove('active')}}
function fecharMenu(){if(!menuAberto)return;menuAberto=false;document.getElementById('menu-dropdown').classList.remove('open');document.getElementById('btn-menu-toggle').classList.remove('active')}

/* ── DONATE ── */
function detectarIconeDoacao(titulo){if(!titulo)return DONATE_ICONS['default'];var t=titulo.toLowerCase().trim();if(t.indexOf('apoia')!==-1)return DONATE_ICONS['apoia.se'];if(t.indexOf('ko-fi')!==-1||t.indexOf('kofi')!==-1)return DONATE_ICONS['ko-fi'];if(t.indexOf('picpay')!==-1)return DONATE_ICONS['picpay'];if(t.indexOf('mercado')!==-1)return DONATE_ICONS['mercadopago'];if(t.indexOf('padrim')!==-1)return DONATE_ICONS['padrim'];if(t.indexOf('ethereum')!==-1||t.indexOf('eth')!==-1)return DONATE_ICONS['ethereum'];if(t.indexOf('bitcoin')!==-1||t.indexOf('btc')!==-1)return DONATE_ICONS['bitcoin'];if(t.indexOf('cripto')!==-1)return DONATE_ICONS['criptomoeda'];if(t.indexOf('pix')!==-1)return DONATE_ICONS['pix'];if(t.indexOf('paypal')!==-1)return DONATE_ICONS['paypal'];return DONATE_ICONS['default']}
async function carregarOpcoesDoacao(){var container=document.getElementById('donate-options-list');if(!container)return;if(donateOptionsCache){renderizarOpcoesDoacao(donateOptionsCache);return}container.innerHTML='<div class="donate-loading"><i class="fas fa-spinner fa-spin"></i> Carregando...</div>';try{var response=await fetch(DONATE_API_URL);if(!response.ok)throw new Error('HTTP '+response.status);var data=await response.json();var lista=Array.isArray(data)?data:null;if(!lista){var chaves=['doacoes','opcoes','donate_options','options','data','items'];for(var i=0;i<chaves.length;i++){if(Array.isArray(data[chaves[i]])){lista=data[chaves[i]];break}}}if(!lista||!lista.length)throw new Error('vazia');donateOptionsCache=lista;renderizarOpcoesDoacao(lista)}catch(err){renderizarOpcoesDoacao([{titulo:'PIX',descricao:'seabhra@gmail.com',tipo:'pix',acao:'copy',valor:'seabhra@gmail.com'},{titulo:'Apoia.se',descricao:'Apoio mensal recorrente',tipo:'apoia.se',acao:'link',url:'#'}])}}
function renderizarOpcoesDoacao(lista){var container=document.getElementById('donate-options-list');if(!container)return;container.innerHTML='';lista.forEach(function(opt,i){var ic=detectarIconeDoacao(opt.titulo||opt.nome||opt.title||'');var titulo=opt.titulo||opt.title||opt.nome||opt.name||'Doar';var desc=opt.descricao||opt.desc||opt.description||'';var url=opt.url||opt.link||'#';var acao=opt.acao||'link';var valorCopy=opt.valor||opt.chave||titulo;var el=document.createElement('div');el.className='donate-option-link';el.style.animation='cardSlideIn 0.35s ease-out '+(i*0.06)+'s both';el.innerHTML='<div class="donate-option-icon-wrap" style="background:'+ic.bg+';color:'+ic.color+';"><i class="'+ic.icon+'"></i></div><div class="donate-option-text"><div class="do-title">'+titulo+'</div>'+(desc?'<div class="do-desc">'+desc+'</div>':'')+'</div><i class="fas fa-external-link-alt" style="color:var(--text-muted);font-size:0.7rem;margin-left:auto;flex-shrink:0;"></i>';(function(a,u,v,tit){el.addEventListener('click',function(){if(a==='copy'||a==='copiar'){if(navigator.clipboard){navigator.clipboard.writeText(v).then(function(){showNotification(tit+': copiado!')})}else{fallbackCopy(v);showNotification(tit+': copiado!')}}else if(u&&u!=='#'){window.open(u,'_blank','noopener');showNotification('Abrindo '+tit+'...')}})})(acao,url,valorCopy,titulo);container.appendChild(el)})}

/* ── PIX: GERADOR BR CODE ── */
function gerarPixCopiaCola(chave,nome,cidade,valor,descricao){
  function campo(id,val){return id+String(val.length).padStart(2,'0')+val}
  function crc16(str){var crc=0xFFFF;for(var i=0;i<str.length;i++){crc^=str.charCodeAt(i)<<8;for(var j=0;j<8;j++){crc=(crc&0x8000)?(crc<<1)^0x1021:crc<<1}}return(crc&0xFFFF).toString(16).toUpperCase().padStart(4,'0')}
  var nomeClean=(nome||'').substring(0,25).toUpperCase();
  var cidadeClean=(cidade||'').substring(0,15).toUpperCase();
  var descClean=(descricao||'').substring(0,72);
  var valorStr=Number(valor).toFixed(2);
  var merchantAcc=campo('26',campo('00','BR.GOV.BCB.PIX')+campo('01',chave)+(descClean?campo('02',descClean):''));
  var addData=campo('62',campo('05','***'));
  var payload='000201'+'010212'+merchantAcc+'52040000'+'5303986'+'54'+String(valorStr.length).padStart(2,'0')+valorStr+'5802BR'+'59'+String(nomeClean.length).padStart(2,'0')+nomeClean+'60'+String(cidadeClean.length).padStart(2,'0')+cidadeClean+addData+'6304';
  return payload+crc16(payload);
}

/* ── PIX: QR CODE ── */
function renderizarQRCode(texto){
  var canvas=document.getElementById('pix-qr-canvas');if(!canvas)return;
  var ctx=canvas.getContext('2d');ctx.clearRect(0,0,180,180);
  if(typeof QRCode!=='undefined'){
    var tmpDiv=document.createElement('div');document.body.appendChild(tmpDiv);
    try{
      new QRCode(tmpDiv,{text:texto,width:180,height:180,colorDark:'#000000',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M});
      setTimeout(function(){var img=tmpDiv.querySelector('img');if(img){var im=new Image();im.onload=function(){ctx.drawImage(im,0,0,180,180)};im.src=img.src}if(tmpDiv.parentNode)document.body.removeChild(tmpDiv)},150)
    }catch(e){if(tmpDiv.parentNode)document.body.removeChild(tmpDiv);_qrFallback(ctx)}
  }else{_qrFallback(ctx)}
}
function _qrFallback(ctx){ctx.fillStyle='#fff';ctx.fillRect(0,0,180,180);ctx.fillStyle='#444';ctx.font='13px Inter,sans-serif';ctx.textAlign='center';ctx.fillText('Use Copia e Cola',90,80);ctx.fillText('abaixo ↓',90,100)}

/* ── PIX: COUNTDOWN ── */
function iniciarCountdownPix(){
  clearInterval(pixCountdownInterval);var segundos=600;
  pixCountdownInterval=setInterval(function(){
    segundos--;
    var m=Math.floor(segundos/60);var s=segundos%60;
    var countEl=document.getElementById('pix-countdown');if(countEl)countEl.textContent=m+':'+String(s).padStart(2,'0');
    if(segundos<=60){var timerEl=document.getElementById('pix-timer-box');if(timerEl)timerEl.classList.add('urgente')}
    if(segundos<=0){clearInterval(pixCountdownInterval);_setStatusPix('erro','<i class="fas fa-times-circle"></i> QR expirado. Volte e gere novamente.')}
  },1000)
}
function _setStatusPix(tipo,html){var el=document.getElementById('pix-status-msg');if(!el)return;el.className='pix-status-msg '+tipo;el.innerHTML=html}

/* ── PIX: SALVAR LOJA ── */
async function salvarLojaNoSupabase(form,status){
  var payload={loja_nome:form.nome,loja_url:form.url,loja_categoria:form.categoria,loja_email:form.email,plano_dias:parseInt(form.dias),valor_pago:parseFloat(form.valor),data_expiracao:calcularExpiracao(form.dias),pix_txid:pixTxid||('MANUAL_'+Date.now()),status:status||'aguardando_validacao',modo_pagamento:'pix_manual'};
  try{var r=await fetch('/api/salvar-loja',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error('HTTP '+r.status);return await r.json()}
  catch(e){console.error('[Max Promo] salvarLoja:',e);try{var key='maxpromo_lojas_pendentes';var pending=JSON.parse(localStorage.getItem(key)||'[]');pending.push(Object.assign({},payload,{tentativa_em:new Date().toISOString()}));localStorage.setItem(key,JSON.stringify(pending))}catch(_){}return null}
}

/* ── PIX: STEP 3 ── */
function confirmarPagamentoEAvancar(statusFinal){
  clearInterval(pixPollingInterval);clearInterval(pixCountdownInterval);
  salvarLojaNoSupabase(storeFormData,statusFinal||'aguardando_validacao');
  var resumo=document.getElementById('store-step3-resumo');
  if(resumo)resumo.innerHTML='<div><strong>Loja:</strong> '+storeFormData.nome+'</div><div><strong>URL:</strong> '+storeFormData.url+'</div><div><strong>Plano:</strong> '+storeFormData.label+' ('+formatarDinheiro(storeFormData.valor)+')</div><div><strong>Válido até:</strong> '+calcularExpiracao(storeFormData.dias)+'</div><div><strong>Status:</strong> <span style="color:#4CAF50;">✔ Solicitação recebida — publicação em até 24h</span></div>';
  document.getElementById('store-step-2').style.display='none';
  document.getElementById('store-step-3').style.display='block';
}

/*
 * FIX CRÍTICO — selecionarPlano()
 * Deve ser função GLOBAL (não dentro de DOMContentLoaded)
 * pois é chamada via onclick="selecionarPlano(this)" no HTML.
 * Habilita o botão Continuar E oculta o aviso de plano obrigatório.
 */
function selecionarPlano(el){
  document.querySelectorAll('.plano-card').forEach(function(c){c.classList.remove('selected')});
  el.classList.add('selected');
  var dias=el.getAttribute('data-dias');
  var valor=parseFloat(el.getAttribute('data-valor'));
  if(!PLANOS[dias]){console.error('[Max Promo] Plano inválido:',dias);return}
  planoSelecionado={dias:dias,valor:valor,label:PLANOS[dias].label};
  var btn=document.getElementById('btn-store-step1-next');
  if(btn)btn.disabled=false;
  var aviso=document.getElementById('plano-aviso');
  if(aviso)aviso.classList.remove('visivel');
  showNotification('Plano '+PLANOS[dias].label+' selecionado: '+formatarDinheiro(valor));
}

/* ── PIX: LIMPAR MODAL ── */
function limparModalLoja(){
  clearInterval(pixCountdownInterval);clearInterval(pixPollingInterval);
  planoSelecionado=null;storeFormData={};pixTxid=null;
  ['input-store-name','input-store-url','input-store-email'].forEach(function(id){
    var el=document.getElementById(id);
    if(el){el.value='';el.classList.remove('input-error')}
  });
  var sel=document.getElementById('input-store-cat');if(sel)sel.selectedIndex=0;
  var btn=document.getElementById('btn-store-step1-next');if(btn)btn.disabled=true;
  var countdown=document.getElementById('pix-countdown');if(countdown)countdown.textContent='10:00';
  var timerBox=document.getElementById('pix-timer-box');if(timerBox)timerBox.classList.remove('urgente');
  var aviso=document.getElementById('plano-aviso');if(aviso)aviso.classList.remove('visivel');
  _setStatusPix('aguardando','<i class="fas fa-hourglass-half" style="color:var(--accent-color);"></i> Aguardando confirmação do pagamento...');
  document.querySelectorAll('.plano-card').forEach(function(c){c.classList.remove('selected')});
  document.getElementById('store-step-1').style.display='block';
  document.getElementById('store-step-2').style.display='none';
  document.getElementById('store-step-3').style.display='none';
}

/* ─────────────────────────────────────────────────
   [EFI] Descomente quando Efi Bank estiver aprovado:

function iniciarPollingEfi(txid){...}
async function criarCobrancaEfi(valor,descricao){...}
───────────────────────────────────────────────── */

/* ═══════════════════════════════════════════════
   DOMContentLoaded — ÚNICO bloco de eventos
   ═══════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', function(){

  preTestarTodosIcones();
  setTimeout(function(){document.getElementById('loading-fullscreen').classList.add('fade-out')},1200);
  setTimeout(function(){document.getElementById('loading-fullscreen').style.display='none'},1800);

  /* Menu */
  document.getElementById('btn-menu-toggle').addEventListener('click',function(e){e.stopPropagation();toggleMenu()});
  document.addEventListener('click',function(e){if(!e.target.closest('#btn-menu-toggle')&&!e.target.closest('#menu-dropdown'))fecharMenu()});
  document.getElementById('menu-info').addEventListener('click',function(){openModal('modal-info')});
  document.getElementById('menu-donate').addEventListener('click',function(){carregarOpcoesDoacao();openModal('modal-donate')});
  document.getElementById('menu-promo-types').addEventListener('click',function(){renderPromoTypesGrid();openModal('modal-promo-types')});

  /* FIX: stopPropagation impede que o click suba e chame fecharMenu antes de openModal */
  document.getElementById('menu-monitorar').addEventListener('click',function(e){e.stopPropagation();openModal('modal-add-product')});
  document.getElementById('menu-inserir-loja').addEventListener('click',function(e){e.stopPropagation();openModal('modal-add-store')});

  /* Fechar modais */
  document.getElementById('btn-info-close').addEventListener('click',function(){closeModal('modal-info')});
  document.getElementById('btn-donate-close').addEventListener('click',function(){closeModal('modal-donate')});
  document.getElementById('btn-types-close').addEventListener('click',function(){closeModal('modal-promo-types')});
  document.getElementById('btn-modal-cancel').addEventListener('click',function(){closeModal('modal-add-product')});
  document.getElementById('btn-compare-close').addEventListener('click',function(){closeModal('modal-compare')});
  document.querySelectorAll('.modal-overlay').forEach(function(o){o.addEventListener('click',function(e){if(e.target===o)o.classList.remove('active')})});

  /* Monitorar produto */
  document.getElementById('btn-modal-confirm').addEventListener('click',function(){
    var nm=document.getElementById('input-prod-name').value.trim();
    var tg=parseFloat(document.getElementById('input-prod-target').value);
    if(!nm){marcarErro('input-prod-name','Digite o nome do produto');return}
    if(!tg||tg<=0){marcarErro('input-prod-target','Digite um preço alvo válido');return}
    monitoredProducts.push({name:nm,targetPrice:tg,currentPrice:Math.round(tg*(1+Math.random()*0.4)*100)/100,category:document.getElementById('input-prod-category').value});
    document.getElementById('input-prod-name').value='';
    document.getElementById('input-prod-target').value='';
    closeModal('modal-add-product');atualizarBadgeMonitorados();showNotification('✔ Produto adicionado à monitoração');
    if(tabAtiva==='monitored')renderMonitored();
  });

  /* ── Modal Inserir Loja — Step 1 → 2 ── */
  document.getElementById('btn-store-cancel').addEventListener('click',function(){limparModalLoja();closeModal('modal-add-store')});
  document.getElementById('btn-store-step2-back').addEventListener('click',function(){clearInterval(pixCountdownInterval);clearInterval(pixPollingInterval);document.getElementById('store-step-2').style.display='none';document.getElementById('store-step-1').style.display='block'});
  document.getElementById('btn-store-step3-close').addEventListener('click',function(){limparModalLoja();closeModal('modal-add-store')});

  /*
   * FIX PRINCIPAL — btn-store-step1-next
   * Validação completa com toast + highlight de campo inválido.
   * Se plano não selecionado, mostra aviso inline na grade de planos.
   */
  document.getElementById('btn-store-step1-next').addEventListener('click',function(){
    var nome=document.getElementById('input-store-name').value.trim();
    var url=document.getElementById('input-store-url').value.trim();
    var cat=document.getElementById('input-store-cat').value;
    var email=document.getElementById('input-store-email').value.trim();

    /* Limpa erros anteriores */
    ['input-store-name','input-store-url','input-store-email'].forEach(function(id){
      var el=document.getElementById(id);if(el)el.classList.remove('input-error');
    });

    /* Valida plano */
    if(!planoSelecionado){
      var aviso=document.getElementById('plano-aviso');
      if(aviso)aviso.classList.add('visivel');
      showNotification('⚠ Selecione um plano para continuar');
      return;
    }

    /* Valida campos obrigatórios */
    if(!nome){marcarErro('input-store-name','Digite o nome da loja');return}
    if(!url){marcarErro('input-store-url','Digite a URL da loja');return}
    if(email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
      marcarErro('input-store-email','E-mail inválido');return;
    }

    storeFormData={nome:nome,url:url,categoria:cat,email:email,dias:planoSelecionado.dias,valor:planoSelecionado.valor,label:planoSelecionado.label};
    pixTxid='MAXPROMO_'+Date.now();

    var pixCode=gerarPixCopiaCola(PIX_CONFIG.chave,PIX_CONFIG.nome,PIX_CONFIG.cidade,planoSelecionado.valor,PIX_CONFIG.descricao+' '+planoSelecionado.label);
    document.getElementById('pix-key-display').value=pixCode;
    renderizarQRCode(pixCode);

    var vf=formatarDinheiro(planoSelecionado.valor);
    document.getElementById('pix-valor-label').textContent=vf;
    document.getElementById('pix-dias-label').textContent=planoSelecionado.label;
    document.getElementById('instrucao-valor').textContent=vf;
    document.getElementById('dev-bar-teste').style.display=MODO_TESTE?'flex':'none';

    iniciarCountdownPix();
    document.getElementById('store-step-1').style.display='none';
    document.getElementById('store-step-2').style.display='block';
  });

  /* PIX: copiar chave */
  document.getElementById('btn-copy-pix').addEventListener('click',function(){
    var val=document.getElementById('pix-key-display').value;
    if(!val){showNotification('Código não disponível ainda');return}
    if(navigator.clipboard){navigator.clipboard.writeText(val).then(function(){showNotification('✔ Chave PIX copiada!')}).catch(function(){fallbackCopy(val);showNotification('✔ Chave PIX copiada!')})}
    else{fallbackCopy(val);showNotification('✔ Chave PIX copiada!')}
  });

  /* PIX: já paguei */
  document.getElementById('btn-store-step2-paguei').addEventListener('click',function(){
    var btn=this;btn.disabled=true;
    btn.innerHTML='<i class="fas fa-spinner fa-spin" style="margin-right:5px;"></i> Verificando...';
    _setStatusPix('aguardando','<i class="fas fa-spinner fa-spin" style="color:var(--accent-color);"></i> Registrando solicitação...');
    setTimeout(function(){
      confirmarPagamentoEAvancar('aguardando_validacao');
      btn.disabled=false;
      btn.innerHTML='<i class="fas fa-check-circle" style="font-size:.8rem;margin-right:5px;"></i>Já Paguei';
    },1200);
  });

  /* Dev: simular pagamento */
  document.getElementById('btn-dev-simular').addEventListener('click',function(){
    if(!MODO_TESTE)return;
    showNotification('🧪 Pagamento simulado!');
    setTimeout(function(){confirmarPagamentoEAvancar('pago_simulado')},500);
  });

  /* Tabs */
  document.querySelectorAll('.tab-btn').forEach(function(b){b.addEventListener('click',function(){document.querySelectorAll('.tab-btn').forEach(function(x){x.classList.remove('active')});this.classList.add('active');tabAtiva=this.getAttribute('data-tab');renderCurrentTab();document.getElementById('filter-strip').style.display=tabAtiva==='feed'?'flex':'none'})});

  /* Busca */
  var sb=document.getElementById('search-bar'),sf=document.getElementById('btn-search-toggle');
  sf.addEventListener('click',function(){searchActive=!searchActive;sb.classList.toggle('active',searchActive);sf.classList.toggle('hidden-fab',searchActive);if(searchActive)document.getElementById('search-query').focus()});
  document.getElementById('btn-search').addEventListener('click',function(){if(tabAtiva==='feed')renderFeed();showNotification('Busca atualizada')});
  document.getElementById('search-query').addEventListener('keydown',function(e){if(e.key==='Enter'){if(tabAtiva==='feed')renderFeed();showNotification('Busca atualizada')}});

  /* Alerta */
  document.getElementById('alert-close-btn').addEventListener('click',function(){esconderAlertaVisual()});

  /* Render inicial */

/* ── SUPABASE ───────────────────────────────────── */
async function buscarPromocoesSupabase(){try{var u='/api/promos?limite=50';if(filtroAtivo)u+='&tipo='+filtroAtivo;var r=await fetch(u);if(!r.ok)throw 0;var d=await r.json();if(d.promocoes&&d.promocoes.length>0){supabaseOnline=true;document.getElementById('status-dot').classList.remove('offline');return d.promocoes.map(function(p){return{id:p.id,tipo:p.tipo,titulo:p.titulo,desc:p.descricao||'',loja:p.loja||'?',precoOld:p.preco_antigo||0,precoNew:p.preco_novo||0,cupom:p.cupom||null,tempoRestante:p.tempo_restante||0,fonte:p.fonte||'',urlAfiliado:p.url_afiliado||null}})}return null}catch(e){supabaseOnline=false;document.getElementById('status-dot').classList.add('offline');return null}}

/* ── ALERTA ─────────────────────────────────────── */
function dispararAlertaPromocaoIA(msg,tipo){if(!alertasAtivados)return;var bar=document.getElementById('alert-bar');bar.classList.remove('alert-bar-critico');bar.style.background='';bar.style.color='';bar.style.borderTopColor='';var c=PROMO_CONFIG[tipo]||PROMO_CONFIG['desconto'];document.getElementById('alert-title').textContent=c.emoji+' '+c.label+'!';document.getElementById('alert-text').textContent=msg;var ib=document.getElementById('alert-icon-box');ib.style.background='linear-gradient(135deg,'+c.color+','+ajustarBrilho(c.color,-25)+')';ib.innerHTML=gerarHTMLIcone(tipo,'grande');if(c.urgent||tipo==='blackfriday')bar.classList.add('alert-bar-critico');if(tipo==='flash'){bar.style.background='linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+')';bar.style.color='#000'}else if(tipo==='blackfriday'){bar.style.background='linear-gradient(90deg,#212121,#111)';bar.style.borderTopColor='#FFD700';bar.style.color='#FFD700'}else if(tipo==='bilhete'){bar.style.background='linear-gradient(90deg,#1a1a2e,#16213e)';bar.style.borderTopColor='#FFD700';bar.style.color='#FFD700'}else{bar.style.background='linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+')';bar.style.color='#fff'}var ct=document.getElementById('alert-container');if(ct.style.display!=='block'){ct.style.display='block';ct.style.animation='none';ct.offsetHeight;ct.style.animation='slideUp 0.35s ease-out'}try{var snd=document.getElementById('alert-sound');if(snd&&snd.src){snd.currentTime=0;snd.play().catch(function(){})}}catch(e){}clearTimeout(alertTimeout);alertTimeout=setTimeout(function(){esconderAlertaVisual()},6000);savingsTotal+=Math.floor(Math.random()*80)+20;document.getElementById('savings-total').textContent='R$ '+savingsTotal.toLocaleString('pt-BR')}
function esconderAlertaVisual(){document.getElementById('alert-container').style.display='none';var b=document.getElementById('alert-bar');b.classList.remove('alert-bar-critico');b.style.color='';b.style.borderTopColor=''}

/* ── TIMERS DE FLASH SALE ───────────────────────── */
function iniciarTimer(id,seg){var rem=seg;clearInterval(flashTimers[id]);flashTimers[id]=setInterval(function(){rem--;var el=document.getElementById('timer-'+id);if(!el){clearInterval(flashTimers[id]);return}if(rem<=0){el.querySelector('.timer-value').textContent='Encerrado';el.classList.add('urgent');clearInterval(flashTimers[id]);return}el.querySelector('.timer-value').textContent=formatarTempo(rem);if(rem<600)el.classList.add('urgent')},1000)}

/* ── RENDER FEED ────────────────────────────────── */
async function renderFeed(promos){var ct=document.getElementById('feed-container');ct.innerHTML='';var lista=promos;if(!lista){var sd=await buscarPromocoesSupabase();lista=sd||MOCK_PROMOS}if(filtroAtivo)lista=lista.filter(function(p){return p.tipo===filtroAtivo});var q=document.getElementById('search-query').value.trim().toLowerCase();if(q.length>=2)lista=lista.filter(function(p){return p.titulo.toLowerCase().indexOf(q)!==-1||p.desc.toLowerCase().indexOf(q)!==-1||p.loja.toLowerCase().indexOf(q)!==-1||(PROMO_CONFIG[p.tipo]&&PROMO_CONFIG[p.tipo].label.toLowerCase().indexOf(q)!==-1)});if(!lista.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-search"></i><p>Nenhuma oferta encontrada.</p></div>';return}lista.forEach(function(p,i){var c=PROMO_CONFIG[p.tipo]||PROMO_CONFIG['desconto'];var card=document.createElement('div');card.className='promo-card';card.style.animationDelay=(i*0.06)+'s';var u=c.urgent,l=c.isLive,ht=p.tempoRestante>0;var po=p.precoOld>0?'R$ '+p.precoOld.toLocaleString('pt-BR'):'';var pn=p.precoNew>0?'R$ '+p.precoNew.toLocaleString('pt-BR'):'Gratuito';var pd='';if(p.precoOld>0&&p.precoNew>0){var pc=Math.round((1-p.precoNew/p.precoOld)*100);if(pc>0)pd='-'+pc+'%'}var hh='';var hi=MOCK_PRICE_HISTORY[p.id];if(hi&&hi.length){var mx=Math.max.apply(null,hi),mn=Math.min.apply(null,hi);hh='<div class="price-history-mini">';hi.forEach(function(v){var h=3+((v-mn)/(mx-mn+1))*27;var cl=v===hi[hi.length-1]?'#4CAF50':'rgba(255,255,255,0.15)';hh+='<div class="price-bar" style="height:'+h+'px;background:'+cl+';"></div>'});hh+='</div>'}var th='';if(ht)th='<div class="promo-timer urgent" id="timer-'+p.id+'"><i class="fas fa-clock"></i> <span class="timer-value">'+formatarTempo(p.tempoRestante)+'</span></div>';var bc=c.goldAccent||c.color;var bt='Aproveitar';if(p.cupom)bt='Cupom: '+p.cupom;if(l)bt='Assistir Live';var lh=l?'<div class="live-indicator"><div class="live-dot"></div> AO VIVO</div>':'';var sh=p.fonte?'<span class="source-badge" style="background:rgba(255,255,255,0.05);color:var(--text-muted);"><i class="fas fa-rss" style="font-size:0.5rem;"></i> '+p.fonte+'</span>':'';var ih=gerarHTMLIcone(p.tipo,'pequeno');card.innerHTML='<div class="promo-card-accent" style="background:linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+');"></div><div class="promo-card-body"><div class="promo-card-icon" style="background:linear-gradient(135deg,'+c.color+','+ajustarBrilho(c.color,-30)+');">'+ih+(u?'<div class="pulse-ring"></div>':'')+'</div><div class="promo-card-content"><div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;"><span class="promo-card-type" style="background:'+ajustarBrilho(c.color,-60)+';color:'+c.color+';">'+c.label+'</span>'+(pd?'<span style="font-size:0.72rem;font-weight:800;color:#4CAF50;">'+pd+'</span>':'')+lh+sh+'</div><div class="promo-card-title">'+p.titulo+'</div><div class="promo-card-desc">'+p.desc+'</div><div class="promo-card-meta">'+(po?'<span class="promo-price-old">'+po+'</span>':'')+'<span class="promo-price-new" style="color:'+(p.precoNew<p.precoOld?'#4CAF50':'var(--text-main)')+';">'+pn+'</span><span class="promo-store"><i class="fas fa-store"></i> '+p.loja+'</span></div>'+hh+'</div></div><div class="promo-card-footer">'+th+'<button class="promo-btn-grab" style="background:linear-gradient(135deg,'+bc+','+ajustarBrilho(bc,-15)+');">'+bt+'</button></div>';ct.appendChild(card);if(p.urlAfiliado)card.addEventListener('click',function(){window.open(p.urlAfiliado,'_blank','noopener')});if(ht)iniciarTimer(p.id,p.tempoRestante)})}

function renderMonitored(){var ct=document.getElementById('feed-container');ct.innerHTML='';if(!monitoredProducts.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-eye-slash"></i><p>Nenhum produto monitorado.<br>Use o menu para adicionar.</p></div>';return}monitoredProducts.forEach(function(p,i){var card=document.createElement('div');card.className='monitored-card';card.style.animationDelay=(i*0.06)+'s';var sc='#4CAF50';if(p.currentPrice>p.targetPrice*1.1)sc='#ff4444';else if(p.currentPrice>p.targetPrice)sc='#FFB300';card.innerHTML='<div class="prod-img" style="color:'+sc+';"><i class="fas fa-box"></i></div><div class="prod-info"><div class="prod-name">'+p.name+'</div><div class="prod-target">Alvo: R$ '+p.targetPrice.toLocaleString('pt-BR')+'</div></div><div class="prod-current" style="color:'+sc+';">R$ '+p.currentPrice.toLocaleString('pt-BR')+'</div><button class="remove-btn" data-idx="'+i+'" title="Remover"><i class="fas fa-trash"></i></button>';ct.appendChild(card);card.querySelector('.remove-btn').addEventListener('click',function(){monitoredProducts.splice(parseInt(this.getAttribute('data-idx')),1);renderMonitored();atualizarBadgeMonitorados();showNotification('Produto removido')})})}

function renderHistory(){var ct=document.getElementById('feed-container');ct.innerHTML='';var pp=MOCK_PROMOS.filter(function(p){return MOCK_PRICE_HISTORY[p.id]});if(!pp.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-chart-line"></i><p>Nenhum historico.</p></div>';return}var ms=['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];pp.forEach(function(p,i){var c=PROMO_CONFIG[p.tipo]||PROMO_CONFIG['desconto'];var h=MOCK_PRICE_HISTORY[p.id];var mx=Math.max.apply(null,h),mn=Math.min.apply(null,h);var card=document.createElement('div');card.className='promo-card';card.style.animationDelay=(i*0.06)+'s';var bh='<div style="display:flex;align-items:flex-end;gap:4px;height:80px;padding:10px 0;">';h.forEach(function(v,j){var hi=8+((v-mn)/(mx-mn+1))*65;var cl=j===h.length-1?'#4CAF50':'rgba(255,179,0,0.3)';bh+='<div style="display:flex;flex-direction:column;align-items:center;flex:1;gap:2px;"><div style="width:100%;height:'+hi+'px;background:'+cl+';border-radius:3px 3px 0 0;min-height:4px;"></div><span style="font-size:0.5rem;color:var(--text-muted);">'+ms[j]+'</span></div>'});bh+='</div>';card.innerHTML='<div class="promo-card-accent" style="background:linear-gradient(90deg,'+c.color+','+ajustarBrilho(c.color,-20)+');"></div><div style="padding:14px 16px;"><div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;"><span class="promo-card-type" style="background:'+ajustarBrilho(c.color,-60)+';color:'+c.color+';">'+c.label+'</span><span style="font-weight:700;font-size:0.9rem;">'+p.titulo+'</span></div><div style="display:flex;gap:16px;font-size:0.8rem;margin-bottom:4px;"><span style="color:var(--text-muted);">Maior: R$ '+mx.toLocaleString('pt-BR')+'</span><span style="color:#4CAF50;">Menor: R$ '+mn.toLocaleString('pt-BR')+'</span></div>'+bh+'</div>';ct.appendChild(card)})}

function renderCompare(){var ct=document.getElementById('feed-container');ct.innerHTML='';var pk=Object.keys(MOCK_COMPARE);if(!pk.length){ct.innerHTML='<div class="empty-state"><i class="fas fa-balance-scale"></i><p>Nenhum produto para comparar.</p></div>';return}pk.forEach(function(nm,i){var ls=MOCK_COMPARE[nm].slice().sort(function(a,b){return a.preco-b.preco});var ml=ls[0].preco;var card=document.createElement('div');card.className='promo-card';card.style.animationDelay=(i*0.06)+'s';var rh='';ls.forEach(function(l){var ib=l.preco===ml;rh+='<div class="compare-row"><span class="compare-store"><i class="fas fa-store" style="margin-right:6px;color:'+(ib?'#4CAF50':'var(--text-muted)')+';"></i>'+l.loja+(ib?' <span style="font-size:0.65rem;font-weight:800;color:#4CAF50;">MELHOR PRECO</span>':'')+'</span><span class="compare-price '+(ib?'compare-best':'')+'">R$ '+l.preco.toLocaleString('pt-BR')+'</span></div>'});card.innerHTML='<div class="promo-card-accent" style="background:linear-gradient(90deg,#4CAF50,#2E7D32);"></div><div style="padding:14px 16px;"><div style="font-weight:700;font-size:0.95rem;margin-bottom:12px;"><i class="fas fa-balance-scale" style="margin-right:8px;color:#4CAF50;"></i>'+nm+'</div>'+rh+'</div>';ct.appendChild(card)})}

function renderFilters(){var st=document.getElementById('filter-strip');st.innerHTML='';var ca=document.createElement('button');ca.className='filter-chip'+(!filtroAtivo?' active':'');ca.innerHTML='<i class="fas fa-th"></i> Todos';ca.addEventListener('click',function(){filtroAtivo=null;renderFilters();renderCurrentTab()});st.appendChild(ca);['flash','cupom','frete_gratis','cashback','leve_pague','blackfriday','saldao','outlet','desconto','brinde','progressivo','combo','parcela','live','misterio','sorteio'].forEach(function(t){var c=PROMO_CONFIG[t];if(!c)return;var ch=document.createElement('button');ch.className='filter-chip'+(filtroAtivo===t?' active':'');ch.innerHTML='<span class="chip-dot" style="background:'+c.color+';"></span> '+c.label;ch.addEventListener('click',function(){filtroAtivo=filtroAtivo===t?null:t;renderFilters();renderCurrentTab()});st.appendChild(ch)})}

function renderPromoTypesGrid(){var g=document.getElementById('promo-types-grid');g.innerHTML='';Object.keys(PROMO_CONFIG).forEach(function(t){var c=PROMO_CONFIG[t];var it=document.createElement('div');it.className='promo-type-item';it.innerHTML='<div class="promo-type-dot" style="background:'+c.color+';"></div><div class="promo-type-label">'+c.emoji+' '+c.label+'</div>';g.appendChild(it)})}

function renderCurrentTab(){if(tabAtiva==='feed')renderFeed();else if(tabAtiva==='monitored')renderMonitored();else if(tabAtiva==='history')renderHistory();else if(tabAtiva==='compare')renderCompare()}

function atualizarBadgeMonitorados(){var b=document.getElementById('monitored-count');if(monitoredProducts.length>0){b.style.display='flex';b.textContent=monitoredProducts.length}else{b.style.display='none'}}

/* ── MENU ───────────────────────────────────────── */
function toggleMenu(){menuAberto=!menuAberto;var d=document.getElementById('menu-dropdown');var t=document.getElementById('btn-menu-toggle');if(menuAberto){d.classList.add('open');t.classList.add('active')}else{d.classList.remove('open');t.classList.remove('active')}}
function fecharMenu(){if(!menuAberto)return;menuAberto=false;document.getElementById('menu-dropdown').classList.remove('open');document.getElementById('btn-menu-toggle').classList.remove('active')}

/* ── DONATE ─────────────────────────────────────── */
function detectarIconeDoacao(titulo){if(!titulo)return DONATE_ICONS['default'];var t=titulo.toLowerCase().trim();if(t.indexOf('apoia')!==-1)return DONATE_ICONS['apoia.se'];if(t.indexOf('ko-fi')!==-1||t.indexOf('kofi')!==-1)return DONATE_ICONS['ko-fi'];if(t.indexOf('picpay')!==-1)return DONATE_ICONS['picpay'];if(t.indexOf('mercado')!==-1)return DONATE_ICONS['mercadopago'];if(t.indexOf('padrim')!==-1)return DONATE_ICONS['padrim'];if(t.indexOf('ethereum')!==-1||t.indexOf('eth')!==-1)return DONATE_ICONS['ethereum'];if(t.indexOf('bitcoin')!==-1||t.indexOf('btc')!==-1)return DONATE_ICONS['bitcoin'];if(t.indexOf('cripto')!==-1)return DONATE_ICONS['criptomoeda'];if(t.indexOf('pix')!==-1)return DONATE_ICONS['pix'];if(t.indexOf('paypal')!==-1)return DONATE_ICONS['paypal'];return DONATE_ICONS['default']}

async function carregarOpcoesDoacao(){var container=document.getElementById('donate-options-list');if(!container)return;if(donateOptionsCache){renderizarOpcoesDoacao(donateOptionsCache);return}container.innerHTML='<div class="donate-loading"><i class="fas fa-spinner fa-spin"></i> Carregando...</div>';try{var response=await fetch(DONATE_API_URL);if(!response.ok)throw new Error('HTTP '+response.status);var data=await response.json();var lista=Array.isArray(data)?data:null;if(!lista){var chaves=['doacoes','opcoes','donate_options','options','data','items'];for(var i=0;i<chaves.length;i++){if(Array.isArray(data[chaves[i]])){lista=data[chaves[i]];break}}}if(!lista||!lista.length)throw new Error('vazia');donateOptionsCache=lista;renderizarOpcoesDoacao(lista)}catch(err){renderizarOpcoesDoacao([{titulo:'PIX',descricao:'seabhra@gmail.com',tipo:'pix',acao:'copy',valor:'seabhra@gmail.com'},{titulo:'Apoia.se',descricao:'Apoio mensal recorrente',tipo:'apoia.se',acao:'link',url:'#'}])}}

function renderizarOpcoesDoacao(lista){var container=document.getElementById('donate-options-list');if(!container)return;container.innerHTML='';lista.forEach(function(opt,i){var ic=detectarIconeDoacao(opt.titulo||opt.nome||opt.title||'');var titulo=opt.titulo||opt.title||opt.nome||opt.name||'Doar';var desc=opt.descricao||opt.desc||opt.description||'';var url=opt.url||opt.link||'#';var acao=opt.acao||'link';var valorCopy=opt.valor||opt.chave||titulo;var el=document.createElement('div');el.className='donate-option-link';el.style.animation='cardSlideIn 0.35s ease-out '+(i*0.06)+'s both';el.innerHTML='<div class="donate-option-icon-wrap" style="background:'+ic.bg+';color:'+ic.color+';"><i class="'+ic.icon+'"></i></div><div class="donate-option-text"><div class="do-title">'+titulo+'</div>'+(desc?'<div class="do-desc">'+desc+'</div>':'')+'</div><i class="fas fa-external-link-alt" style="color:var(--text-muted);font-size:0.7rem;margin-left:auto;flex-shrink:0;"></i>';(function(a,u,v,tit){el.addEventListener('click',function(){if(a==='copy'||a==='copiar'){if(navigator.clipboard){navigator.clipboard.writeText(v).then(function(){showNotification(tit+': copiado!')})}else{fallbackCopy(v);showNotification(tit+': copiado!')}}else if(u&&u!=='#'){window.open(u,'_blank','noopener');showNotification('Abrindo '+tit+'...')}})})(acao,url,valorCopy,titulo);container.appendChild(el)})}

/* ── PIX: GERADOR BR CODE ───────────────────────── */
function gerarPixCopiaCola(chave,nome,cidade,valor,descricao){
  function campo(id,val){return id+String(val.length).padStart(2,'0')+val}
  function crc16(str){var crc=0xFFFF;for(var i=0;i<str.length;i++){crc^=str.charCodeAt(i)<<8;for(var j=0;j<8;j++){crc=(crc&0x8000)?(crc<<1)^0x1021:crc<<1}}return(crc&0xFFFF).toString(16).toUpperCase().padStart(4,'0')}
  var nomeClean=(nome||'').substring(0,25).toUpperCase();
  var cidadeClean=(cidade||'').substring(0,15).toUpperCase();
  var descClean=(descricao||'').substring(0,72);
  var valorStr=Number(valor).toFixed(2);
  var merchantAcc=campo('26',campo('00','BR.GOV.BCB.PIX')+campo('01',chave)+(descClean?campo('02',descClean):''));
  var addData=campo('62',campo('05','***'));
  var payload='000201'+'010212'+merchantAcc+'52040000'+'5303986'+'54'+String(valorStr.length).padStart(2,'0')+valorStr+'5802BR'+'59'+String(nomeClean.length).padStart(2,'0')+nomeClean+'60'+String(cidadeClean.length).padStart(2,'0')+cidadeClean+addData+'6304';
  return payload+crc16(payload)
}

/* ── PIX: QR CODE ───────────────────────────────── */
function renderizarQRCode(texto){
  var canvas=document.getElementById('pix-qr-canvas');if(!canvas)return;
  var ctx=canvas.getContext('2d');ctx.clearRect(0,0,180,180);
  if(typeof QRCode!=='undefined'){
    var tmpDiv=document.createElement('div');document.body.appendChild(tmpDiv);
    try{new QRCode(tmpDiv,{text:texto,width:180,height:180,colorDark:'#000000',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M});
    setTimeout(function(){var img=tmpDiv.querySelector('img');if(img){var i=new Image();i.onload=function(){ctx.drawImage(i,0,0,180,180)};i.src=img.src}if(tmpDiv.parentNode)document.body.removeChild(tmpDiv)},150)}
    catch(e){if(tmpDiv.parentNode)document.body.removeChild(tmpDiv);_qrFallback(ctx)}
  }else{_qrFallback(ctx)}
}
function _qrFallback(ctx){ctx.fillStyle='#fff';ctx.fillRect(0,0,180,180);ctx.fillStyle='#444';ctx.font='13px Inter,sans-serif';ctx.textAlign='center';ctx.fillText('Use Copia e Cola',90,80);ctx.fillText('abaixo ↓',90,100)}

/* ── PIX: COUNTDOWN ─────────────────────────────── */
function iniciarCountdownPix(){
  clearInterval(pixCountdownInterval);var segundos=600;
  pixCountdownInterval=setInterval(function(){
    segundos--;
    var m=Math.floor(segundos/60);var s=segundos%60;
    var countEl=document.getElementById('pix-countdown');if(countEl)countEl.textContent=m+':'+String(s).padStart(2,'0');
    if(segundos<=60){var timerEl=document.getElementById('pix-timer-box');if(timerEl)timerEl.classList.add('urgente')}
    if(segundos<=0){clearInterval(pixCountdownInterval);_setStatusPix('erro','<i class="fas fa-times-circle"></i> QR expirado. Volte e gere novamente.')}
  },1000)
}
function _setStatusPix(tipo,html){var el=document.getElementById('pix-status-msg');if(!el)return;el.className='pix-status-msg '+tipo;el.innerHTML=html}

/* ── PIX: SALVAR LOJA ───────────────────────────── */
async function salvarLojaNoSupabase(form,status){
  var payload={loja_nome:form.nome,loja_url:form.url,loja_categoria:form.categoria,loja_email:form.email,plano_dias:parseInt(form.dias),valor_pago:parseFloat(form.valor),data_expiracao:calcularExpiracao(form.dias),pix_txid:pixTxid||('MANUAL_'+Date.now()),status:status||'aguardando_validacao',modo_pagamento:'pix_manual'};
  try{var r=await fetch('/api/salvar-loja',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error('HTTP '+r.status);return await r.json()}
  catch(e){console.error('[Max Promo] salvarLoja:',e);try{var key='maxpromo_lojas_pendentes';var pending=JSON.parse(localStorage.getItem(key)||'[]');pending.push(Object.assign({},payload,{tentativa_em:new Date().toISOString()}));localStorage.setItem(key,JSON.stringify(pending))}catch(_){}return null}
}

/* ── PIX: AVANÇO PARA STEP 3 ───────────────────── */
function confirmarPagamentoEAvancar(statusFinal){
  clearInterval(pixPollingInterval);clearInterval(pixCountdownInterval);
  salvarLojaNoSupabase(storeFormData,statusFinal||'aguardando_validacao');
  var resumo=document.getElementById('store-step3-resumo');
  if(resumo){resumo.innerHTML='<div><strong>Loja:</strong> '+storeFormData.nome+'</div><div><strong>URL:</strong> '+storeFormData.url+'</div><div><strong>Plano:</strong> '+storeFormData.label+' ('+formatarDinheiro(storeFormData.valor)+')</div><div><strong>Válido até:</strong> '+calcularExpiracao(storeFormData.dias)+'</div><div><strong>Status:</strong> <span style="color:#4CAF50;">✔ Solicitação recebida — publicação em até 24h</span></div>'}
  document.getElementById('store-step-2').style.display='none';
  document.getElementById('store-step-3').style.display='block'
}

/* ── PIX: SELEÇÃO DE PLANO (global — usada pelo onclick HTML) ── */
function selecionarPlano(el){
  document.querySelectorAll('.plano-card').forEach(function(c){c.classList.remove('selected')});
  el.classList.add('selected');
  var dias=el.getAttribute('data-dias');var valor=parseFloat(el.getAttribute('data-valor'));
  planoSelecionado={dias:dias,valor:valor,label:PLANOS[dias].label};
  var btn=document.getElementById('btn-store-step1-next');if(btn)btn.disabled=false
}

/* ── PIX: LIMPAR MODAL ──────────────────────────── */
function limparModalLoja(){
  clearInterval(pixCountdownInterval);clearInterval(pixPollingInterval);
  planoSelecionado=null;storeFormData={};pixTxid=null;
  ['input-store-name','input-store-url','input-store-email'].forEach(function(id){var el=document.getElementById(id);if(el)el.value=''});
  var btnNext=document.getElementById('btn-store-step1-next');if(btnNext)btnNext.disabled=true;
  var countdown=document.getElementById('pix-countdown');if(countdown)countdown.textContent='10:00';
  var timerBox=document.getElementById('pix-timer-box');if(timerBox)timerBox.classList.remove('urgente');
  _setStatusPix('aguardando','<i class="fas fa-hourglass-half" style="color:var(--accent-color);"></i> Aguardando confirmação do pagamento...');
  document.querySelectorAll('.plano-card').forEach(function(c){c.classList.remove('selected')});
  document.getElementById('store-step-1').style.display='block';
  document.getElementById('store-step-2').style.display='none';
  document.getElementById('store-step-3').style.display='none'
}

/* ─────────────────────────────────────────────────
   [EFI] POLLING AUTOMÁTICO — aguardando aprovação do banco
   Descomente quando o txid Efi Bank estiver liberado.

function iniciarPollingEfi(txid){
  clearInterval(pixPollingInterval);
  pixPollingInterval=setInterval(async function(){
    try{var r=await fetch('/api/verificar-pagamento-pix?txid='+txid);if(!r.ok)return;var d=await r.json();if(d.pago)confirmarPagamentoEAvancar('pago')}
    catch(e){console.warn('[Efi] polling:',e)}
  },5000)
}

async function criarCobrancaEfi(valor,descricao){
  var r=await fetch('/api/criar-cobranca-pix',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({valor:Number(valor).toFixed(2),descricao:descricao})});
  if(!r.ok)throw new Error('Efi HTTP '+r.status);
  return await r.json();
  // retorna: { txid, pixCopiaECola, qrCodeBase64, expiracao }
}
───────────────────────────────────────────────── */

/* ═══════════════════════════════════════════════
   DOMContentLoaded — único bloco de eventos
   ═══════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', function() {

  preTestarTodosIcones();
  setTimeout(function(){document.getElementById('loading-fullscreen').classList.add('fade-out')},1200);
  setTimeout(function(){document.getElementById('loading-fullscreen').style.display='none'},1800);

  /* ── Menu ── */
  document.getElementById('btn-menu-toggle').addEventListener('click',function(e){e.stopPropagation();toggleMenu()});
  document.addEventListener('click',function(e){if(!e.target.closest('#btn-menu-toggle')&&!e.target.closest('#menu-dropdown'))fecharMenu()});
  document.getElementById('menu-info').addEventListener('click',function(){openModal('modal-info')});
  document.getElementById('menu-donate').addEventListener('click',function(){carregarOpcoesDoacao();openModal('modal-donate')});
  document.getElementById('menu-promo-types').addEventListener('click',function(){renderPromoTypesGrid();openModal('modal-promo-types')});
  document.getElementById('menu-monitorar').addEventListener('click',function(){openModal('modal-add-product')});
  document.getElementById('menu-inserir-loja').addEventListener('click',function(){openModal('modal-add-store')});

  /* ── Fechar modais ── */
  document.getElementById('btn-info-close').addEventListener('click',function(){closeModal('modal-info')});
  document.getElementById('btn-donate-close').addEventListener('click',function(){closeModal('modal-donate')});
  document.getElementById('btn-types-close').addEventListener('click',function(){closeModal('modal-promo-types')});
  document.getElementById('btn-modal-cancel').addEventListener('click',function(){closeModal('modal-add-product')});
  document.getElementById('btn-compare-close').addEventListener('click',function(){closeModal('modal-compare')});
  document.querySelectorAll('.modal-overlay').forEach(function(o){o.addEventListener('click',function(e){if(e.target===o)o.classList.remove('active')})});

  /* ── Monitorar produto ── */
  document.getElementById('btn-modal-confirm').addEventListener('click',function(){
    var nm=document.getElementById('input-prod-name').value.trim();
    var tg=parseFloat(document.getElementById('input-prod-target').value);
    if(!nm){showNotification('Digite o nome do produto');return}
    if(!tg||tg<=0){showNotification('Digite um preco alvo valido');return}
    monitoredProducts.push({name:nm,targetPrice:tg,currentPrice:Math.round(tg*(1+Math.random()*0.4)*100)/100,category:document.getElementById('input-prod-category').value});
    document.getElementById('input-prod-name').value='';document.getElementById('input-prod-target').value='';
    closeModal('modal-add-product');atualizarBadgeMonitorados();showNotification('Produto adicionado a monitoracao');if(tabAtiva==='monitored')renderMonitored()
  });

  /* ── Modal Inserir Loja ── */
  document.getElementById('btn-store-cancel').addEventListener('click',function(){limparModalLoja();closeModal('modal-add-store')});
  document.getElementById('btn-store-step2-back').addEventListener('click',function(){clearInterval(pixCountdownInterval);clearInterval(pixPollingInterval);document.getElementById('store-step-2').style.display='none';document.getElementById('store-step-1').style.display='block'});
  document.getElementById('btn-store-step3-close').addEventListener('click',function(){limparModalLoja();closeModal('modal-add-store')});

  document.getElementById('btn-store-step1-next').addEventListener('click',function(){
    var nome=document.getElementById('input-store-name').value.trim();
    var url=document.getElementById('input-store-url').value.trim();
    var cat=document.getElementById('input-store-cat').value;
    var email=document.getElementById('input-store-email').value.trim();
    if(!nome){showNotification('Digite o nome da loja');return}
    if(!url){showNotification('Digite a URL da loja');return}
    if(!planoSelecionado){showNotification('Selecione um plano');return}
    storeFormData={nome:nome,url:url,categoria:cat,email:email,dias:planoSelecionado.dias,valor:planoSelecionado.valor,label:planoSelecionado.label};
    pixTxid='MAXPROMO_'+Date.now();

    /* MODO MANUAL — gera payload PIX localmente */
    var pixCode=gerarPixCopiaCola(PIX_CONFIG.chave,PIX_CONFIG.nome,PIX_CONFIG.cidade,planoSelecionado.valor,PIX_CONFIG.descricao+' '+planoSelecionado.label);
    document.getElementById('pix-key-display').value=pixCode;
    renderizarQRCode(pixCode);
    /* [EFI] substitua o bloco acima por criarCobrancaEfi(...).then(...) quando o txid estiver aprovado */

    var vf=formatarDinheiro(planoSelecionado.valor);
    document.getElementById('pix-valor-label').textContent=vf;
    document.getElementById('pix-dias-label').textContent=planoSelecionado.label;
    document.getElementById('instrucao-valor').textContent=vf;
    document.getElementById('dev-bar-teste').style.display=MODO_TESTE?'flex':'none';
    iniciarCountdownPix();
    document.getElementById('store-step-1').style.display='none';
    document.getElementById('store-step-2').style.display='block'
  });

  document.getElementById('btn-copy-pix').addEventListener('click',function(){
    var val=document.getElementById('pix-key-display').value;
    if(!val){showNotification('Código não disponível');return}
    if(navigator.clipboard){navigator.clipboard.writeText(val).then(function(){showNotification('Chave PIX copiada!')}).catch(function(){fallbackCopy(val);showNotification('Chave PIX copiada!')})}
    else{fallbackCopy(val);showNotification('Chave PIX copiada!')}
  });

  document.getElementById('btn-store-step2-paguei').addEventListener('click',function(){
    var btn=this;btn.disabled=true;
    btn.innerHTML='<i class="fas fa-spinner fa-spin" style="margin-right:5px;"></i> Verificando...';
    _setStatusPix('aguardando','<i class="fas fa-spinner fa-spin" style="color:var(--accent-color);"></i> Registrando solicitação...');

    /* MODO MANUAL — registra e avança */
    setTimeout(function(){
      confirmarPagamentoEAvancar('aguardando_validacao');
      btn.disabled=false;
      btn.innerHTML='<i class="fas fa-check-circle" style="font-size:.8rem;margin-right:5px;"></i> Já Paguei'
    },1200);
    /* [EFI] substitua o setTimeout por fetch('/api/verificar-pagamento-pix?txid='+pixTxid)... */
  });

  document.getElementById('btn-dev-simular').addEventListener('click',function(){
    if(!MODO_TESTE)return;
    showNotification('🧪 Pagamento simulado!');
    setTimeout(function(){confirmarPagamentoEAvancar('pago_simulado')},500)
  });

  /* ── Tabs ── */
  document.querySelectorAll('.tab-btn').forEach(function(b){b.addEventListener('click',function(){document.querySelectorAll('.tab-btn').forEach(function(x){x.classList.remove('active')});this.classList.add('active');tabAtiva=this.getAttribute('data-tab');renderCurrentTab();document.getElementById('filter-strip').style.display=tabAtiva==='feed'?'flex':'none'})});

  /* ── Busca ── */
  var sb=document.getElementById('search-bar');var sf=document.getElementById('btn-search-toggle');
  sf.addEventListener('click',function(){searchActive=!searchActive;sb.classList.toggle('active',searchActive);sf.classList.toggle('hidden-fab',searchActive);if(searchActive)document.getElementById('search-query').focus()});
  document.getElementById('btn-search').addEventListener('click',function(){if(tabAtiva==='feed')renderFeed();showNotification('Busca atualizada')});
  document.getElementById('search-query').addEventListener('keydown',function(e){if(e.key==='Enter'){if(tabAtiva==='feed')renderFeed();showNotification('Busca atualizada')}});

  /* ── Alerta ── */
  document.getElementById('alert-close-btn').addEventListener('click',function(){esconderAlertaVisual()});

  /* ── Render inicial ── */
  renderFilters();
  renderFeed();
});
</script>
</body>
</html>





